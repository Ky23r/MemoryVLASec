#!/usr/bin/env bash
# Central configuration for every real DGX evaluation path. Environment
# variables set by the caller take precedence over these defaults.

MODEL_ID="${MODEL_ID:-shihao1895/memvla-libero-spatial}"
DATASET_ID="${DATASET_ID:-shihao1895/libero-rlds}"
CACHE_DIR="${CACHE_DIR:-${PROJECT_ROOT}/.cache/memoryvlasec}"
DEVICE="${DEVICE:-cuda}"
NUM_EPISODES="${NUM_EPISODES:-10}"
MAX_STEPS="${MAX_STEPS:-220}"
POISON_RATE="${POISON_RATE:-1.0}"
ATTACK_CHECKPOINT="${ATTACK_CHECKPOINT:-${CACHE_DIR}/security/badvla_stage2.pt}"
DEFENSE_CHECKPOINT="${DEFENSE_CHECKPOINT:-${CACHE_DIR}/security/amemguard.json}"
OUTPUT_DIR="${OUTPUT_DIR:-${PROJECT_ROOT}/output}"

CONDA_ENV="${CONDA_ENV:-memoryvlasec}"
MODEL_REVISION="${MODEL_REVISION:-4d6572ce289736e459e38a48f8671b557a6fd078}"
MODEL_CHECKPOINT_FILE="${MODEL_CHECKPOINT_FILE:-checkpoints/memvla-libero-spatial.pt}"
DATASET_REVISION="${DATASET_REVISION:-92c18c77d610218e838d8c8d4fc6410f3cbe7b18}"
DATASET_CONFIG="${DATASET_CONFIG:-libero_spatial_no_noops}"
TOKENIZER_ID="${TOKENIZER_ID:-hf-internal-testing/llama-tokenizer}"
TOKENIZER_REVISION="${TOKENIZER_REVISION:-d02ad6cb9dd2c2296a6332199fa2fdca5938fef0}"
TASK_SUITE_NAME="${TASK_SUITE_NAME:-libero_spatial}"
UNNORM_KEY="${UNNORM_KEY:-libero_spatial_no_noops}"
ACTION_CHUNKING_WINDOW="${ACTION_CHUNKING_WINDOW:-8}"
NUM_DDIM_STEPS="${NUM_DDIM_STEPS:-10}"
NUM_STEPS_WAIT="${NUM_STEPS_WAIT:-10}"
SEED="${SEED:-42}"
TRIGGER_SIZE="${TRIGGER_SIZE:-0.10}"
BADVLA_LOSS_P="${BADVLA_LOSS_P:-0.5}"
AMEMGUARD_MIN_CLUSTER_SIZE="${AMEMGUARD_MIN_CLUSTER_SIZE:-2}"
AMEMGUARD_CALIBRATION_QUANTILE="${AMEMGUARD_CALIBRATION_QUANTILE:-0.95}"
AMEMGUARD_CALIBRATION_TRANSITIONS="${AMEMGUARD_CALIBRATION_TRANSITIONS:-256}"
BADVLA_STAGE1_MAX_STEPS="${BADVLA_STAGE1_MAX_STEPS:-5000}"
BADVLA_STAGE2_MAX_STEPS="${BADVLA_STAGE2_MAX_STEPS:-30000}"
BADVLA_LEARNING_RATE="${BADVLA_LEARNING_RATE:-1e-5}"
BADVLA_LR_DECAY_STEP="${BADVLA_LR_DECAY_STEP:-100000}"
LIBERO_REPOSITORY="${LIBERO_REPOSITORY:-https://github.com/Lifelong-Robot-Learning/LIBERO.git}"
LIBERO_REVISION="${LIBERO_REVISION:-8f1084e3132a39270c3a13ebe37270a43ece2a01}"
LIBERO_ROOT="${LIBERO_ROOT:-${CACHE_DIR}/LIBERO}"
LIBERO_CONFIG_PATH="${LIBERO_CONFIG_PATH:-${CACHE_DIR}/libero-config}"

export MODEL_ID DATASET_ID CACHE_DIR DEVICE NUM_EPISODES MAX_STEPS POISON_RATE
export ATTACK_CHECKPOINT DEFENSE_CHECKPOINT OUTPUT_DIR CONDA_ENV MODEL_REVISION
export MODEL_CHECKPOINT_FILE
export DATASET_REVISION DATASET_CONFIG TASK_SUITE_NAME UNNORM_KEY ACTION_CHUNKING_WINDOW
export TOKENIZER_ID TOKENIZER_REVISION
export NUM_DDIM_STEPS
export NUM_STEPS_WAIT SEED TRIGGER_SIZE BADVLA_LOSS_P
export AMEMGUARD_MIN_CLUSTER_SIZE AMEMGUARD_CALIBRATION_QUANTILE
export AMEMGUARD_CALIBRATION_TRANSITIONS BADVLA_STAGE1_MAX_STEPS
export BADVLA_STAGE2_MAX_STEPS BADVLA_LEARNING_RATE BADVLA_LR_DECAY_STEP
export LIBERO_REPOSITORY LIBERO_REVISION LIBERO_ROOT LIBERO_CONFIG_PATH
