#!/usr/bin/env bash
# Shared defaults for asset downloads, training, and evaluation scripts.
# Prefix a command with an environment variable to override any value.

MODEL_ID="${MODEL_ID:-shihao1895/memvla-libero-spatial}"
DATASET_ID="${DATASET_ID:-shihao1895/libero-rlds}"
CACHE_DIR="${CACHE_DIR:-${PROJECT_ROOT}/.cache/memoryvlasec}"
DEVICE="${DEVICE:-cuda}"
MIN_FREE_VRAM_MB="${MIN_FREE_VRAM_MB:-40000}"
GPU_WAIT_INTERVAL_SECONDS="${GPU_WAIT_INTERVAL_SECONDS:-30}"
NUM_EPISODES="${NUM_EPISODES:-50}"
# Empty selects the official suite-specific limits (220/280/300/520/400).
MAX_STEPS="${MAX_STEPS:-}"
POISON_RATE="${POISON_RATE:-1.0}"
BADVLA_CHECKPOINT="${BADVLA_CHECKPOINT:-${CACHE_DIR}/security/badvla_v3_stage2.pt}"
MEMORYVLA_OUTPUT_DIR="${MEMORYVLA_OUTPUT_DIR:-${CACHE_DIR}/finetuned_memoryvla}"
MEMORYVLA_MAX_STEPS="${MEMORYVLA_MAX_STEPS:-20000}"
DROPVLA_OUTPUT_DIR="${DROPVLA_OUTPUT_DIR:-${CACHE_DIR}/security/dropvla}"
DROPVLA_CHECKPOINT="${DROPVLA_CHECKPOINT:-${DROPVLA_OUTPUT_DIR}/dropvla.pt}"
OUTPUT_DIR="${OUTPUT_DIR:-${PROJECT_ROOT}/output}"
DROPVLA_DATASET_PATH="${DROPVLA_DATASET_PATH:-}"

MODEL_REVISION="${MODEL_REVISION:-4d6572ce289736e459e38a48f8671b557a6fd078}"
MODEL_CHECKPOINT_FILE="${MODEL_CHECKPOINT_FILE:-checkpoints/memvla-libero-spatial.pt}"
DATASET_REVISION="${DATASET_REVISION:-92c18c77d610218e838d8c8d4fc6410f3cbe7b18}"
DATASET_CONFIG="${DATASET_CONFIG:-libero_spatial_no_noops}"
TOKENIZER_ID="${TOKENIZER_ID:-hf-internal-testing/llama-tokenizer}"
TOKENIZER_REVISION="${TOKENIZER_REVISION:-d02ad6cb9dd2c2296a6332199fa2fdca5938fef0}"
TASK_SUITE_NAME="${TASK_SUITE_NAME:-libero_spatial}"
UNNORM_KEY="${UNNORM_KEY:-libero_spatial_no_noops}"
ACTION_CHUNKING_WINDOW="${ACTION_CHUNKING_WINDOW:-8}"
NUM_DDIM_STEPS="${NUM_DDIM_STEPS:-10}"
NUM_STEPS_WAIT="${NUM_STEPS_WAIT:-10}"
SEED="${SEED:-42}"

TRIGGER_SIZE="${TRIGGER_SIZE:-0.10}"
BADVLA_LOSS_P="${BADVLA_LOSS_P:-0.5}"
BADVLA_EPOCHS="${BADVLA_EPOCHS:-10}"
BADVLA_STAGE1_MAX_STEPS="${BADVLA_STAGE1_MAX_STEPS:-5000}"
BADVLA_STAGE2_MAX_STEPS="${BADVLA_STAGE2_MAX_STEPS:-30000}"
BADVLA_STAGE1_LEARNING_RATE="${BADVLA_STAGE1_LEARNING_RATE:-5e-4}"
BADVLA_STAGE2_LEARNING_RATE="${BADVLA_STAGE2_LEARNING_RATE:-5e-5}"
BADVLA_STAGE1_LR_DECAY_STEP="${BADVLA_STAGE1_LR_DECAY_STEP:-1000}"
BADVLA_STAGE2_LR_DECAY_STEP="${BADVLA_STAGE2_LR_DECAY_STEP:-10000}"
BADVLA_STAGE1_LORA_RANK="${BADVLA_STAGE1_LORA_RANK:-4}"
BADVLA_STAGE2_LORA_RANK="${BADVLA_STAGE2_LORA_RANK:-8}"

DROPVLA_EPOCHS="${DROPVLA_EPOCHS:-1}"
DROPVLA_LEARNING_RATE="${DROPVLA_LEARNING_RATE:-2e-5}"
DROPVLA_MODALITY="${DROPVLA_MODALITY:-vision}"
DROPVLA_PROTOCOL="${DROPVLA_PROTOCOL:-paper_faithful}"
DROPVLA_EPISODE_POISON_RATE="${DROPVLA_EPISODE_POISON_RATE:-0.0031}"
DROPVLA_RELABEL_LENGTH="${DROPVLA_RELABEL_LENGTH:-8}"
DROPVLA_TRIGGER_ALPHA="${DROPVLA_TRIGGER_ALPHA:-1.0}"
DROPVLA_TRIGGER_SHAPE="${DROPVLA_TRIGGER_SHAPE:-circle}"

AMEMGUARD_DIVERGENCE_THRESHOLD="${AMEMGUARD_DIVERGENCE_THRESHOLD:-0.10}"
AMEMGUARD_TOP_K="${AMEMGUARD_TOP_K:-4}"
AMEMGUARD_LESSON_CAPACITY="${AMEMGUARD_LESSON_CAPACITY:-256}"
AMEMGUARD_LESSON_SIMILARITY_THRESHOLD="${AMEMGUARD_LESSON_SIMILARITY_THRESHOLD:-0.90}"

LIBERO_REPOSITORY="${LIBERO_REPOSITORY:-https://github.com/Lifelong-Robot-Learning/LIBERO.git}"
LIBERO_REVISION="${LIBERO_REVISION:-8f1084e3132a39270c3a13ebe37270a43ece2a01}"
LIBERO_ROOT="${LIBERO_ROOT:-${CACHE_DIR}/LIBERO}"
LIBERO_CONFIG_PATH="${LIBERO_CONFIG_PATH:-${CACHE_DIR}/libero-config}"

export MODEL_ID DATASET_ID CACHE_DIR DEVICE MIN_FREE_VRAM_MB
export GPU_WAIT_INTERVAL_SECONDS NUM_EPISODES MAX_STEPS POISON_RATE
export BADVLA_CHECKPOINT DROPVLA_CHECKPOINT DROPVLA_OUTPUT_DIR
export MEMORYVLA_OUTPUT_DIR MEMORYVLA_MAX_STEPS
export OUTPUT_DIR
export DROPVLA_DATASET_PATH MODEL_REVISION MODEL_CHECKPOINT_FILE
export DATASET_REVISION DATASET_CONFIG TOKENIZER_ID TOKENIZER_REVISION
export TASK_SUITE_NAME UNNORM_KEY ACTION_CHUNKING_WINDOW NUM_DDIM_STEPS
export NUM_STEPS_WAIT SEED TRIGGER_SIZE BADVLA_LOSS_P BADVLA_STAGE1_MAX_STEPS
export BADVLA_EPOCHS BADVLA_STAGE2_MAX_STEPS BADVLA_STAGE1_LEARNING_RATE BADVLA_STAGE2_LEARNING_RATE
export BADVLA_STAGE1_LR_DECAY_STEP BADVLA_STAGE2_LR_DECAY_STEP
export BADVLA_STAGE1_LORA_RANK BADVLA_STAGE2_LORA_RANK
export DROPVLA_EPOCHS DROPVLA_LEARNING_RATE DROPVLA_MODALITY DROPVLA_PROTOCOL
export DROPVLA_EPISODE_POISON_RATE DROPVLA_RELABEL_LENGTH
export DROPVLA_TRIGGER_ALPHA DROPVLA_TRIGGER_SHAPE
export AMEMGUARD_DIVERGENCE_THRESHOLD AMEMGUARD_TOP_K AMEMGUARD_LESSON_CAPACITY
export AMEMGUARD_LESSON_SIMILARITY_THRESHOLD
export LIBERO_REPOSITORY LIBERO_REVISION
export LIBERO_ROOT LIBERO_CONFIG_PATH
